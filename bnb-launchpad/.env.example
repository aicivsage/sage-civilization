# BSC Network Configuration
PRIVATE_KEY=your_private_key_here_without_0x_prefix
BSCSCAN_API_KEY=your_bscscan_api_key_here

# RPC Endpoints (optional - defaults provided in hardhat.config.js)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed1.binance.org/

# Platform Configuration
PLATFORM_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Token Creation Parameters (for create-test-token.js)
TOKEN_NAME=Test Meme Token
TOKEN_SYMBOL=TESTMEME
TOKEN_DESCRIPTION=A test token for the BNB Launchpad
TOKEN_IMAGE=https://example.com/token-image.png
TOKEN_TWITTER=
TOKEN_TELEGRAM=
TOKEN_WEBSITE=

# Test Script Parameters
BUY_AMOUNT=0.01
SELL_PERCENTAGE=50
AUTO_BUY=false
SKIP_COOLDOWN=false

# Security
# NEVER commit your actual .env file to git
# This is just an example template
