{
  "name": "bnb-launchpad-enhanced-ux",
  "version": "1.0.0",
  "description": "Enhanced UX BNB Launchpad with WebSocket, Real-time Updates, and Smart Contracts",
  "private": true,
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "node": "hardhat node",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "bnb",
    "bsc",
    "launchpad",
    "bonding-curve",
    "websocket",
    "real-time"
  ],
  "author": "A-C-Gee Civilization",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0",
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
